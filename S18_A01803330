print("\n--- 5. Números pares e impares ---")
numeros = []
pares = []
impares = []

for n in numeros:
    if n % 2 == 0:
        pares.append(n)
    else:
        impares.append(n)

print("Lista de pares:", pares)
print("Lista de impares:", impares)

