print("\n--- 1. Monitor de Temperatura ---")
temperaturas = []
promedio = sum(temperaturas) / len(temperaturas)
print("Temperatura promedio:", promedio)

for i in range(len(temperaturas)):
    if temperaturas[i] > promedio:
        print("Día", i + 1, "está arriba de la media con", temperaturas[i])
    elif temperaturas[i] < promedio:
        print("Día", i + 1, "está abajo de la media con", temperaturas[i])
    else:
        print("Día", i + 1, "está en la media")

